// Silent Corridor X - Domain Controller Credential Theft
// Purpose: Identify staging of ntds.dit, SYSTEM, ntdsutil usage, and suspicious file activity on SRV-DC01.

SilentCorridorX_CL
| where DeviceName == "SRV-DC01"
| extend Time = todatetime(EventTime)
| where ProcessCommandLine has_any (
    "ntdsutil",
    "ifm",
    "create full",
    "ntds.dit",
    "SYSTEM",
    "McAfee_Logs"
)
or FolderPath has_any (
    "McAfee_Logs",
    "ntds.dit",
    "SYSTEM"
)
or FileName has_any (
    "ntdsutil.exe",
    "ntds.dit",
    "SYSTEM"
)
| project
    Time,
    MdeTable,
    DeviceName,
    AccountName,
    ActionType,
    FileName,
    FolderPath,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessAccountName
| order by Time asc
