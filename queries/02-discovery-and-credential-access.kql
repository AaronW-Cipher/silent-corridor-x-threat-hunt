// Silent Corridor X - Discovery and Credential Access
// Purpose: Identify reconnaissance, privileged group enumeration, LSASS checks, SAM targeting, and saved credential discovery.

SilentCorridorX_CL
| where MdeTable == "DeviceProcessEvents"
| where DeviceName == "WS-ENG04"
| where AccountName == "s.brandt"
| extend Time = todatetime(EventTime)
| where ProcessCommandLine has_any (
    "systeminfo",
    "whoami",
    "hostname",
    "ipconfig",
    "Domain Admins",
    "Enterprise Admins",
    "net group",
    "tasklist",
    "lsass.exe",
    "SAM",
    "reg save",
    "reg query",
    "cmdkey"
)
| project
    Time,
    DeviceName,
    AccountName,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine
| order by Time asc
